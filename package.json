{
  "name": "clauseflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:router": "vitest run tests/router",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify:deployed-source": "node scripts/verify-deployed-source.mjs",
    "lint:contract": "genvm-lint check contracts/clauseflow.py --json",
    "preflight:bradbury": "node scripts/preflight-bradbury.mjs",
    "deploy:bradbury": "node scripts/deploy-bradbury.mjs",
    "smoke:bradbury": "node scripts/bradbury-smoke.mjs",
    "resume:settlement": "node scripts/resume-settlement.mjs",
    "snapshot:onchain": "node scripts/export-onchain-snapshot.mjs",
    "demo:video": "powershell -ExecutionPolicy Bypass -File scripts/build-demo-video.ps1"
  },
  "dependencies": {
    "genlayer-js": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.55.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "ethers": "^6.17.0",
    "ganache": "^7.9.2",
    "jsdom": "^25.0.1",
    "solc": "^0.8.30",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
